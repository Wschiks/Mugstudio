# This repo only holds MY work: the "dobbel" theme and the docs.
# WordPress itself, wp-config.php, the database and Local's files stay on the Mac only.
# (Ignore everything, then allow back only what is ours.)
/*
!/.gitignore
!/DEPLOY.md
!/README.md

!/app/
/app/*
!/app/public/
/app/public/*
!/app/public/wp-content/
/app/public/wp-content/*
!/app/public/wp-content/themes/
/app/public/wp-content/themes/*
!/app/public/wp-content/themes/dobbel/

# Never, also not inside the theme
.DS_Store
*.zip
*.log
